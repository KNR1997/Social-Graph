# Copy to .env for local development. The service itself only ever reads the
# process environment; the Makefile is what exports this file.

APP_NAME=go-ddd-service
APP_ENV=development

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_HANDLER_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=debug
LOG_FORMAT=text

# Matches docker-compose.yml.
DATABASE_URL=postgres://app:secret@localhost:5432/app?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE=30m
DB_CONNECT_TIMEOUT=5s
DB_CONNECT_ATTEMPTS=10

# Session cookie. SESSION_COOKIE_SECURE is forced on when APP_ENV=production,
# so this only relaxes it for local HTTP; it cannot weaken production.
SESSION_COOKIE_NAME=sid
SESSION_TTL=720h
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
