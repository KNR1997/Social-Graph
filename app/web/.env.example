# The API origin. Leave empty so requests go to the same origin as the page:
# in development `vite.config.ts` proxies /v1 to the Go service, and in
# production the SPA and the API are expected to sit behind one host.
#
# Setting this to a different origin will break sign-in. The session cookie is
# SameSite=Lax, so the browser withholds it from cross-site mutations; use the
# proxy instead.
VITE_API_URL=

# Where the dev proxy forwards /v1. Matches HTTP_PORT in the root .env.
VITE_API_PROXY_TARGET=http://localhost:8080
